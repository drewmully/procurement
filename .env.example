# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mymully_procurement

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Shopify
SHOPIFY_STORE_URL=mymully.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxx

# ShipHero
SHIPHERO_API_TOKEN=xxxxx

# Anthropic (AI)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM_ADDRESS=purchasing@mymully.com
EMAIL_REPLY_TO=purchasing@mymully.com

# Inbound Email
INBOUND_EMAIL_ADDRESS=invoices@in.mymully.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# JWT
JWT_SECRET=your-jwt-secret
